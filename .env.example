# ── LLM Provider ────────────────────────────────────────────────────────────
# Set to "github" to use GitHub Models (free, no Azure subscription needed)
# Set to "azure" (default) to use Azure OpenAI
LLM_PROVIDER=github

# ── GitHub Models (LLM_PROVIDER=github) ─────────────────────────────────────
# Generate a token at https://github.com/settings/tokens (no special scopes needed)
GITHUB_TOKEN=your-github-token-here
# Available models: https://github.com/marketplace/models
GITHUB_MODELS_DEPLOYMENT=openai/gpt-4.1

# ── Azure OpenAI (LLM_PROVIDER=azure) ───────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-55
AZURE_OPENAI_API_VERSION=2025-01-01-preview
